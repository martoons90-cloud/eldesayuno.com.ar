{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eldesayuno-com-ar",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "el-desayuno-d1",
      "database_id": "f0474948-373a-4522-833b-36eb13858100"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "el-desayuno"
    }
  ]
}
